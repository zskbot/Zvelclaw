{
  "colors": {
    "primary": {
      "$value": "#1A1C1E",
      "$type": "color"
    },
    "secondary": {
      "$value": "#6C7278",
      "$type": "color"
    },
    "tertiary": {
      "$value": "#B8422E",
      "$type": "color"
    },
    "neutral": {
      "$value": "#F7F5F2",
      "$type": "color"
    },
    "on-tertiary": {
      "$value": "#FFFFFF",
      "$type": "color"
    },
    "border": {
      "$value": "#E5E0D8",
      "$type": "color"
    }
  },
  "typography": {
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Public Sans",
        "fontSize": "3rem",
        "fontWeight": 700
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Public Sans",
        "fontSize": "1rem",
        "fontWeight": 400
      }
    },
    "label-caps": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Space Grotesk",
        "fontSize": "0.75rem",
        "fontWeight": 600
      }
    }
  },
  "spacing": {
    "sm": {
      "$value": "8px",
      "$type": "dimension"
    },
    "md": {
      "$value": "16px",
      "$type": "dimension"
    },
    "lg": {
      "$value": "24px",
      "$type": "dimension"
    }
  },
  "rounded": {
    "sm": {
      "$value": "4px",
      "$type": "dimension"
    },
    "md": {
      "$value": "8px",
      "$type": "dimension"
    }
  }
}